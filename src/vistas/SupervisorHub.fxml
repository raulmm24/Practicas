<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<StackPane prefHeight="600.0" prefWidth="900.0"
           styleClass="data-background"
           stylesheets="/estilo/hub.css"
           xmlns="http://javafx.com/javafx/8"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="controladores.SupervisorHubController">

    <BorderPane>
        <top>
            <HBox alignment="CENTER_RIGHT">
                <BorderPane.margin>
                    <Insets top="30" right="40" bottom="20"/>
                </BorderPane.margin>
                <ComboBox fx:id="comboDepartamentos"
                          styleClass="combo-box"
                          prefWidth="220"
                          promptText="Seleccionar departamento">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="💻  Informática" />
                            <String fx:value="📣  Marketing" />
                            <String fx:value="📈  Ventas" />
                            <String fx:value="🤝  Comercial" />
                            <String fx:value="🎓  Formación" />
                        </FXCollections>
                    </items>
                </ComboBox>
            </HBox>
        </top>

        <center>
            <VBox alignment="CENTER" spacing="50">
                <padding><Insets bottom="50" left="40"/></padding>
                <Label styleClass="titulo" text="Panel de Control" />

                <HBox alignment="CENTER" spacing="40">
                    <VBox fx:id="cardEquipo" onMouseClicked="#irAGestionEquipo" styleClass="card-objetivo" alignment="CENTER">
                        <Label style="-fx-font-size: 50;" text="👥" />
                        <Label style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #0f172a;" text="Gestión de Equipo" />
                        <Label style="-fx-text-fill: #64748b;" text="Consulta valoraciones." />
                    </VBox>

                    <VBox fx:id="cardObjetivos" onMouseClicked="#irAObjetivos" styleClass="card-objetivo" alignment="CENTER">
                        <Label style="-fx-font-size: 50;" text="🎯" />
                        <Label style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #0f172a;" text="Objetivos Depto." />
                        <Label style="-fx-text-fill: #64748b;" text="Supervisa metas." />
                    </VBox>
                </HBox>

                <Button onAction="#cerrarSesion" styleClass="button-ghost" text="⏻ Salir" />
            </VBox>
        </center>
    </BorderPane>
</StackPane>